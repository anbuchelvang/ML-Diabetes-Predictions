# Environment Configuration Example
PORT=5000
SECRET_KEY=super-secret-diabetes-prediction-key-change-in-production
JWT_SECRET=super-secret-jwt-token-key-change-in-production

# SQLite database default (automatically created at backend/database/diabetes_app.db)
# To use MySQL in production, set MYSQL_DATABASE_URI:
# MYSQL_DATABASE_URI=mysql+pymysql://username:password@localhost:3306/diabetes_db

# Frontend API URL configuration
VITE_API_BASE_URL=http://127.0.0.1:5000/api
